  "securityConfiguration": {
    "breakInheritance": true,
    "customPermissions": [
      {
        "principal": "SentinelLog-Administrators",
        "permission": "Full Control",
        "scope": "Site"
      },
      {
        "principal": "SentinelLog-Users",
        "permission": "Contribute",
        "scope": "ChatGPT-Logs"
      },
      {
        "principal": "SentinelLog-ReadOnly",
        "permission": "Read",
        "scope": "ChatGPT-Logs"
      }
    ]
  },
  "workflowConfiguration": {
    "enableWorkflows": true,
    "retentionPolicy": {
      "enabled": true,
      "defaultRetentionDays": 2555,
      "disposition": "Delete"
    },
    "auditLog": {
      "enabled": true,
      "events": ["View", "Edit", "Delete", "Download", "Share"]
    }
