{
  "siteConfiguration": {
    "siteName": "SentinelLog",
    "siteDescription": "Compliant ChatGPT conversation logging system",
    "siteTemplate": "STS#3",
    "siteUrl": "https://yourorganization.sharepoint.com/sites/SentinelLog",
    "owner": "admin@yourorganization.com",
    "createdDate": "2024-01-01T00:00:00Z",
    "permissions": {
      "owners": ["SentinelLog-Administrators"],
      "members": ["SentinelLog-Users"],
      "visitors": ["SentinelLog-ReadOnly"]
    }
  },
  "documentLibraries": [
    {
      "name": "ChatGPT-Logs",
      "description": "Primary storage for ChatGPT conversation transcripts",
      "enableVersioning": true,
      "majorVersionLimit": 10,
      "minorVersionsEnabled": false,
      "enableContentApproval": false,
      "enableFolderCreation": true,
      "enableRequireCheckOut": false,
      "customColumns": [
        {
          "displayName": "Context Code",
          "internalName": "SentinelLog_ContextCode",
          "type": "Text",
          "required": true,
          "maxLength": 10,
          "description": "Context classification code (e.g., 100, 200, 300, 400)"
        },
        {
          "displayName": "Function Code",
          "internalName": "SentinelLog_FunctionCode",
          "type": "Text",
          "required": true,
          "maxLength": 10,
          "description": "Function classification code (e.g., 001-007)"
        },
        {
          "displayName": "Dependency Code",
          "internalName": "SentinelLog_DependencyCode",
          "type": "Text",
          "required": true,
          "maxLength": 10,
          "description": "Dependency classification code (e.g., 001-007)"
        },
        {
          "displayName": "Iteration Code",
          "internalName": "SentinelLog_IterationCode",
          "type": "Text",
          "required": true,
          "maxLength": 10,
          "description": "Iteration number (e.g., 001-999)"
        },
        {
          "displayName": "Flag Code",
          "internalName": "SentinelLog_FlagCode",
          "type": "Text",
          "required": false,
          "maxLength": 5,
          "description": "Optional flag code (P, U, R, D, F)"
        },
        {
          "displayName": "User Email",
          "internalName": "SentinelLog_UserEmail",
          "type": "Text",
          "required": true,
          "maxLength": 255,
          "description": "Email of the user who submitted the log"
        },
        {
          "displayName": "User Full Name",
          "internalName": "SentinelLog_UserFullName",
          "type": "Text",
          "required": true,
          "maxLength": 255,
          "description": "Full name of the user who submitted the log"
        },
        {
          "displayName": "Description",
          "internalName": "SentinelLog_Description",
          "type": "Note",
          "required": false,
          "description": "User-provided description or tags"
        },
        {
          "displayName": "Processed Date",
          "internalName": "SentinelLog_ProcessedDate",
          "type": "DateTime",
          "required": true,
          "description": "Date and time when the log was processed"
        },
        {
          "displayName": "Compliance Status",
          "internalName": "SentinelLog_ComplianceStatus",
          "type": "Choice",
          "required": true,
          "defaultValue": "Compliant",
          "choices": ["Compliant", "Pending Review", "Non-Compliant"],
          "description": "Document compliance status"
        },
        {
          "displayName": "Retention Period",
          "internalName": "SentinelLog_RetentionPeriod",
          "type": "Number",
          "required": false,
          "defaultValue": 2555,
          "description": "Retention period in days (default: 7 years)"
        },
        {
          "displayName": "Classification Level",
          "internalName": "SentinelLog_ClassificationLevel",
          "type": "Choice",
          "required": true,
          "defaultValue": "Internal",
          "choices": ["Public", "Internal", "Confidential", "Restricted"],
          "description": "Information classification level"
        }
      ],
      "contentTypes": [
        {
          "name": "ChatGPT Transcript",
          "description": "Formatted ChatGPT conversation transcript",
          "inheritsFrom": "Document",
          "fileExtensions": [".txt", ".md", ".log"]
        }
      ],
      "views": [
        {
          "name": "All Transcripts",
          "type": "Standard",
          "fields": [
            "Name",
            "SentinelLog_ContextCode",
            "SentinelLog_FunctionCode",
            "SentinelLog_UserFullName",
            "SentinelLog_ProcessedDate",
            "SentinelLog_ComplianceStatus",
            "Modified"
          ],
          "sortBy": "SentinelLog_ProcessedDate",
          "sortOrder": "Descending"
        },
        {
          "name": "By Context",
          "type": "Standard",
          "fields": [
            "Name",
            "SentinelLog_ContextCode",
            "SentinelLog_FunctionCode",
            "SentinelLog_DependencyCode",
            "SentinelLog_ProcessedDate"
          ],
          "groupBy": "SentinelLog_ContextCode",
          "sortBy": "SentinelLog_ProcessedDate",
          "sortOrder": "Descending"
        },
        {
          "name": "By User",
          "type": "Standard",
          "fields": [
            "Name",
            "SentinelLog_UserFullName",
            "SentinelLog_ProcessedDate",
            "SentinelLog_Description"
          ],
          "groupBy": "SentinelLog_UserFullName",
          "sortBy": "SentinelLog_ProcessedDate",
          "sortOrder": "Descending"
        },
        {
          "name": "Recent Activity",
          "type": "Standard",
          "fields": [
            "Name",
            "SentinelLog_UserFullName",
            "SentinelLog_ProcessedDate",
            "SentinelLog_ComplianceStatus"
          ],
          "filter": "SentinelLog_ProcessedDate >= [Today]-7",
          "sortBy": "SentinelLog_ProcessedDate",
          "sortOrder": "Descending"
        }
      ]
    }
  ],
